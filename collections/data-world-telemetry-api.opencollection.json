              {
                "name": "sampleData",
                "value": "",
                "type": "query"
              },
              {
                "name": "catalog",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "This endpoint executes query against ddw-catalogs to get data from governance billing."
        }
      ]
    }
  ],
  "bundled": true
