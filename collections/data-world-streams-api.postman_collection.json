                                ":owner",
                                ":id",
                                ":streamId",
                                "schema"
                              ],
                              "variable": [
                                {
                                  "id": "c2dd8d4a-8dbb-492f-b30c-ac85ac2fec15",
                                  "key": "owner",
                                  "value": "<string>",
                                  "description": "(Required) "
                                },
                                {
                                  "id": "3d9dae45-d02c-4879-afb9-503f4dd3b1fc",
