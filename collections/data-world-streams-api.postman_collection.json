                                "value": "application/json"
                              },
                              {
                                "key": "Accept",
                                "value": "application/json"
                              }
                            ],
                            "body": {
                              "mode": "raw",
                              "raw": "{\n  \"updateMethod\": \"TRUNCATE\",\n  \"primaryKeyFields\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"sequenceField\": \"<string>\"\n}",
                              "options": {
                                "raw": {
                                  "headerFamily": "json",
                                  "language": "json"
                                }
                              }
                            },
                            "url": {
