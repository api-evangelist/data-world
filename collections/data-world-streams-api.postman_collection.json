        {
          "id": "823c4ff9-9d20-4021-8d16-cc107c3f2da7",
          "name": "Set / Update stream schema",
          "request": {
            "name": "Set / Update stream schema",
            "description": {
              "content": "\"Set or update a stream's schema.\n\nThe schema of a stream defines its primary key(s) and sort/sequence field.\n\ndata.world streams are append-only by default. Alternatively, if a primary key is specified, data.world\nwill replace records with the same primary key value. data.world will sort records by sequence field\nvalue and will discard all but the last record appended for each given primary key value.\n\nThe `updateMethod` parameter specifies how data.world should handle existing records when schema is\nupdated. Currently, the only `updateMethod` supported is `TRUNCATED`. data.world will discard all\nrecords when the schema is updated.\"\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "streams",
                ":owner",
                ":id",
                ":streamId",
                "schema"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "owner",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "streamId",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "PATCH",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"updateMethod\": \"<string>\",\n  \"primaryKeyFields\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"sequenceField\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
