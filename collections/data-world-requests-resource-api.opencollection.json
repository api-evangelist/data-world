        {
          "info": {
            "name": "Get a resource request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v0/requests/:requestid",
            "params": [
              {
                "name": "requestid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a resource request. Request can be a contribution on a metadata resource or transfer of a metadata resource into an organization's collections."
        },
        {
          "info": {
            "name": "Delete a resource request",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "/v0/requests/:requestid",
            "params": [
              {
                "name": "requestid",
                "value": "",
                "type": "path",
                "description": "ID of the request to delete."
